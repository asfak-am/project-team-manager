    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get CSRF Cookie",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const setCookieHeaders = pm.response.headers\r",
                  "    .all()\r",
                  "    .filter(header => header.key.toLowerCase() === \"set-cookie\");\r",
                  "\r",
                  "let xsrfToken = null;\r",
                  "\r",
                  "for (const header of setCookieHeaders) {\r",
                  "    const match = header.value.match(/XSRF-TOKEN=([^;]+)/);\r",
                  "\r",
                  "    if (match) {\r",
                  "        xsrfToken = decodeURIComponent(match[1]);\r",
                  "        break;\r",
                  "    }\r",
                  "}\r",
                  "\r",
                  "if (!xsrfToken) {\r",
                  "    throw new Error(\"XSRF-TOKEN was not found in the response headers.\");\r",
                  "}\r",
                  "\r",
                  "pm.collectionVariables.set(\"csrf_token\", xsrfToken);\r",
                  "\r",
                  "console.log(\"CSRF token stored successfully.\");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Origin",
                "value": "http://localhost:3000",
                "type": "text"
              },
              {
                "key": "Referer",
                "value": "http://localhost:3000/",
                "type": "text"
              }
            ],
            "url": {
