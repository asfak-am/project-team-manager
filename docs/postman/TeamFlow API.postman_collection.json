        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "pm.request.headers.upsert({\r",
          "    key: \"Accept\",\r",
          "    value: \"application/json\",\r",
          "});\r",
          "\r",
          "pm.request.headers.upsert({\r",
          "    key: \"Origin\",\r",
          "    value: \"http://localhost:3000\",\r",
          "});\r",
          "\r",
          "pm.request.headers.upsert({\r",
          "    key: \"Referer\",\r",
          "    value: \"http://localhost:3000/\",\r",
          "});\r",
          "\r",
          "const protectedMethods = [\r",
          "    \"POST\",\r",
          "    \"PUT\",\r",
          "    \"PATCH\",\r",
          "    \"DELETE\",\r",
          "];\r",
          "\r",
          "if (protectedMethods.includes(pm.request.method)) {\r",
          "    const csrfToken = pm.collectionVariables.get(\"csrf_token\");\r",
          "\r",
          "    if (!csrfToken) {\r",
          "        throw new Error(\r",
          "            \"CSRF token variable is missing. Send the Get CSRF Cookie request first.\"\r",
          "        );\r",
          "    }\r",
          "\r",
          "    pm.request.headers.upsert({\r",
          "        key: \"X-XSRF-TOKEN\",\r",
          "        value: csrfToken,\r",
          "    });\r",
          "}"
        ]
      }
    },
